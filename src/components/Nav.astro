---
import { t, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
  /** Portada del idioma actual. */
  raiz: string;
  /** La MISMA pagina en el otro idioma, no su portada. */
  otra: string;
  enPortada: boolean;
}
const { idioma, raiz, otra, enPortada } = Astro.props;
const s = t[idioma];

/**
 * Fuera de la portada, un `#notas` a secas no apunta a nada: hay que volver a
 * la portada del idioma y bajar alli. Es el fallo silencioso clasico al
 * anadir la primera pagina interior a un sitio de una sola pagina.
 */
const ancla = (id: string) => (enPortada ? `#${id}` : `${raiz}#${id}`);

const enlaces = [
  { href: ancla('notas'), texto: s.navNotas },
  { href: ancla('trabajo'), texto: s.navTrabajo },
  { href: ancla('trayectoria'), texto: s.navTrayectoria },
  { href: ancla('codigo'), texto: s.navCodigo },
  { href: ancla('contacto'), texto: s.navContacto },
];
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur"
  style="border-color: var(--borde); background: color-mix(in srgb, var(--fondo) 90%, transparent);"
>
  <!--
    Dos filas en movil, una en escritorio, con `order` y sin JavaScript.

    El diseno deja el movil solo con el nombre y el conmutador; aqui se
    conservan ademas los enlaces de seccion, en una segunda fila. El telefono
    es donde se abre un enlace que llega por LinkedIn, y quedarse sin
    navegacion justo ahi ya fue un fallo de la version anterior.
  -->
  <nav class="pagina flex flex-wrap items-center gap-x-5 gap-y-2 py-2.5 sm:h-14 sm:flex-nowrap sm:py-0">
    <a href={raiz} class="order-1 mr-auto" style="font-family: var(--font-mono);">
      <span class="hidden text-[0.6875rem] font-medium tracking-[0.02em] sm:inline">{s.marca}</span>
      <span class="text-[0.594rem] font-medium tracking-[0.02em] sm:hidden">{s.marcaCorta}</span>
    </a>

    <div
      class="order-3 flex w-full flex-wrap gap-x-4 gap-y-1 sm:order-2 sm:w-auto sm:gap-x-[1.125rem]"
      style="font-size: var(--text-menu); color: var(--texto-suave);"
    >
      {enlaces.map((e) => <a href={e.href} class="hover:underline">{e.texto}</a>)}
    </div>

    <div class="order-2 flex items-center gap-x-3 sm:order-3 sm:gap-x-4">
      <a href={otra} class="sello hover:underline">{s.otroIdioma}</a>

      <!--
        Tres estados reales: claro, oscuro y sistema. «Sistema» no es la
        ausencia de eleccion, es una eleccion. La logica vive en Base.astro,
        junto al script que evita el destello.
      -->
      <fieldset class="tema">
        <legend class="sr-only">{s.temaLeyenda}</legend>
        <button type="button" data-tema="light" aria-pressed="false">{s.temaClaro}</button>
        <button type="button" data-tema="dark" aria-pressed="false">{s.temaOscuro}</button>
        <button type="button" data-tema="system" aria-pressed="true">{s.temaSistema}</button>
      </fieldset>
    </div>
  </nav>
</header>
