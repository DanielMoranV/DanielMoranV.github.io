---
import { t, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const s = t[idioma];
const raiz = idioma === 'en' ? '/' : '/es/';
const otra = idioma === 'en' ? '/es/' : '/';

const enlaces = [
  { href: '#notas', texto: s.navNotas },
  { href: '#trabajo', texto: s.navTrabajo },
  { href: '#codigo', texto: s.navCodigo },
];
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur"
  style="border-color: var(--borde); background: color-mix(in srgb, var(--fondo) 88%, transparent);"
>
  <!--
    Dos filas en movil, una en escritorio, con `order` y sin duplicar el marcado
    ni encender JavaScript por un menu de tres enlaces.

    Antes los enlaces de seccion eran `hidden sm:inline`, asi que en el telefono
    solo se veian el nombre, el idioma y Contacto — y el telefono es justo donde
    se abre un enlace que llega por LinkedIn.
  -->
  <nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-5 gap-y-2 px-6 py-3">
    <a href={raiz} class="order-1 mr-auto font-semibold tracking-tight">Daniel Morán Vílchez</a>

    <div
      class="order-3 flex w-full flex-wrap gap-x-4 gap-y-1 text-xs sm:order-2 sm:w-auto sm:gap-x-5 sm:text-sm"
    >
      {
        enlaces.map((e) => (
          <a href={e.href} class="hover:underline" style="color: var(--texto-suave);">
            {e.texto}
          </a>
        ))
      }
    </div>

    <div class="order-2 flex items-center gap-x-4 text-sm sm:order-3 sm:gap-x-5">
      <a
        href={otra}
        class="rounded border px-2 py-0.5 text-xs font-medium"
        style="border-color: var(--borde); color: var(--texto-suave);"
      >
        {s.otroIdioma}
      </a>
      <a href="#contacto" class="font-medium hover:underline" style="color: var(--enlace);">
        {s.navContacto}
      </a>
    </div>
  </nav>
</header>
