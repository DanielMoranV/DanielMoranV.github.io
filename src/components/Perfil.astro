---
import { casos } from '../data/casos';
import { cifras } from '../data/cifras';
import { trabajos } from '../data/trabajo';
import { ANIOS, puesto, sistemas } from '../data/trayectoria';
import { piezas } from '../data/opensource';
import { pasos, REGISTRO_URL } from '../data/metodo';
import {
  t,
  stack,
  CORREO,
  GITHUB,
  LINKEDIN,
  HAY_CV,
  FOTO,
  SEGMENTO,
  type Idioma,
} from '../i18n/ui';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const s = t[idioma];

const destacada = casos.find((c) => c.destacado);
const resto = casos.filter((c) => !c.destacado);

const propios = trabajos.filter((w) => w.modelo === 'propio');
const clientes = trabajos.filter((w) => w.modelo === 'cliente');

const separador = 'padding-bottom:1.5rem;border-bottom:1px solid var(--borde)';

/** URL del case study de una nota, en el idioma de la pagina. */
const caso = (slug: string) =>
  idioma === 'en' ? `/${SEGMENTO.en}/${slug}/` : `/es/${SEGMENTO.es}/${slug}/`;
---

<!-- 01 · Perfil -->
<section class="pagina hero con-foto">
  <div>
    <p class="sello meta">{s.heroMeta}</p>
    <h1>{s.heroTitulo}</h1>
    <p class="entrada">{s.heroEntrada}</p>
    <div class="acciones">
      {HAY_CV && <a class="vinculo" href="/cv.pdf">{s.heroCv}</a>}
      <a class="vinculo" href={`mailto:${CORREO}`}>{s.heroCorreo}</a>
      <a class="vinculo" href={GITHUB} target="_blank" rel="noopener noreferrer">
        {s.heroGithub}
      </a>
      <a class="vinculo" href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>

  <img class="retrato" src={FOTO} alt={s.fotoAlt} width="400" height="400" fetchpriority="high" />
</section>

<!-- Cifras: la unica banda a sangre, porque es lo que resuelve los 40 segundos -->
<div class="cifras">
  <div class="pagina">
    {
      cifras.map((c) => (
        <div>
          <div class="valor">{c.valor[idioma]}</div>
          <div class="sello que">{c.que[idioma]}</div>
        </div>
      ))
    }
  </div>
</div>

<!-- 02 · Notas de ingenieria -->
<section id="notas" class="pagina seccion scroll-mt-20">
  <div class="titular">
    <span class="sello sello-acento">02</span>
    <h2>{s.notasTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.notasEtiqueta}</span>
  </div>

  {
    destacada && (
      <article class="ficha destacada" style="padding-bottom:1.75rem;margin-bottom:1.75rem;border-bottom:1px solid var(--borde)">
        <div class="meta">
          <span class="sello sello-acento">{s.destacada}</span>
          <span class="sello">{destacada.sello[idioma]}</span>
          <dl>
            {destacada.ficha?.map((f) => (
              <div>
                <dt>{f.etiqueta[idioma]}</dt>
                <dd class="num">{f.valor[idioma]}</dd>
              </div>
            ))}
          </dl>
          {destacada.prueba && (
            <a class="vinculo" href={destacada.prueba.url} target="_blank" rel="noopener noreferrer">
              {destacada.prueba.texto} ↗
            </a>
          )}
          {destacada.estudio && (
            <a class="vinculo" href={caso(destacada.estudio)}>
              {s.leerCaso} →
            </a>
          )}
        </div>

        <div>
          <h3>{destacada.titulo[idioma]}</h3>
          {destacada.cuerpo[idioma].map((parrafo, i) => (
            <p class={i === 0 ? 'guia' : undefined}>{parrafo}</p>
          ))}

          {destacada.contraste && (
            <div class="contraste">
              <div>
                <span class="sello">{s.antes}</span>
                <p>{destacada.contraste.antes[idioma]}</p>
              </div>
              <div>
                <span class="sello sello-acento">{s.ahora}</span>
                <p style="color: var(--texto)">{destacada.contraste.ahora[idioma]}</p>
              </div>
            </div>
          )}
        </div>
      </article>
    )
  }

  <div class="flex flex-col gap-6">
    {
      resto.map((nota, i) => (
        <article class="ficha" style={i < resto.length - 1 ? separador : undefined}>
          <div class="meta">
            <span class="sello">{nota.sello[idioma]}</span>
            {nota.prueba && (
              <a class="vinculo" href={nota.prueba.url} target="_blank" rel="noopener noreferrer">
                {nota.prueba.texto} ↗
              </a>
            )}
            {nota.estudio && (
              <a class="vinculo" href={caso(nota.estudio)}>
                {s.leerCaso} →
              </a>
            )}
          </div>
          <div>
            <h3>{nota.titulo[idioma]}</h3>
            {nota.cuerpo[idioma].map((parrafo) => (
              <p>{parrafo}</p>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<!-- 03 · En produccion -->
<section id="trabajo" class="pagina seccion scroll-mt-20">
  <div class="titular">
    <span class="sello sello-acento">03</span>
    <h2>{s.trabajoTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.trabajoEtiqueta}</span>
  </div>

  <p class="sello" style="margin:0 0 0.875rem">{s.trabajoPropio}</p>
  <div class="celdas">
    {
      propios.map((w) => (
        <div>
          <div class="con-logo">
            <img class="logotipo" src={w.logo} alt="" width="96" height="96" loading="lazy" />
            <a
              href={w.url}
              target="_blank"
              rel="noopener noreferrer"
              style="font-family:var(--font-serif);font-size:1.25rem;line-height:1.2;color:var(--enlace);text-decoration:none"
            >
              {w.nombre} ↗
            </a>
          </div>
          <span style="font-size:0.8125rem;line-height:1.55">{w.que[idioma]}</span>
          <span class="sello">{w.stack.join(' · ')}</span>
        </div>
      ))
    }
  </div>

  <p class="sello" style="margin:1.5rem 0 0.5rem">{s.trabajoCliente}</p>
  <div style="border-top:1px solid var(--borde)">
    {
      clientes.map((w) => (
        <div class="fila">
          <div class="con-logo">
            <img class="logotipo" src={w.logo} alt="" width="96" height="96" loading="lazy" />
            <a
              href={w.url}
              target="_blank"
              rel="noopener noreferrer"
              style="font-weight:600;font-size:0.844rem;color:var(--enlace);text-decoration:none"
            >
              {w.nombre} ↗
            </a>
          </div>
          <span style="font-size:0.8125rem;line-height:1.55;color:var(--texto-suave)">
            {w.que[idioma]}
          </span>
          <span class="sello">{w.stack.join(' · ')}</span>
        </div>
      ))
    }
  </div>
</section>

<!-- 04 · Trayectoria -->
<section id="trayectoria" class="pagina seccion scroll-mt-20">
  <div class="titular">
    <span class="sello sello-acento">04</span>
    <h2>{s.trayectoriaTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.trayectoriaEtiqueta} · {ANIOS}+ {s.anios}</span>
  </div>

  <!--
    El puesto. La clinica SI se nombra, por decision expresa; lo que no sale
    de aqui es todo lo demas: siglas internas, dominios, repositorios y
    codigo. Se cuenta la ingenieria, no se ensena el sistema.
  -->
  <div class="puesto">
    {
      puesto.logo && (
        <img class="logotipo grande" src={puesto.logo} alt="" width="192" height="192" loading="lazy" />
      )
    }
    <div>
      <p class="sello num" style="margin:0 0 0.25rem">{puesto.periodo}</p>
      <h3 style="margin:0 0 0.125rem;font-size:var(--text-t3)">{puesto.cargo[idioma]}</h3>
      <p class="sello" style="margin:0">{puesto.organizacion} · {puesto.lugar}</p>
    </div>
  </div>

  <p style="margin:1.25rem 0 1.75rem;max-width:var(--container-prosa);line-height:1.68;color:var(--texto-suave)">
    {puesto.que[idioma]}
  </p>

  <p class="sello" style="margin:0 0 0.875rem">{s.sistemasEtiqueta}</p>
  <div class="celdas">
    {
      sistemas.map((sis) => (
        <div>
          <div class="con-logo" style="justify-content:space-between">
            <span style="font-family:var(--font-serif);font-size:1.25rem;line-height:1.2">
              {sis.nombre[idioma]}
            </span>
            <span class={`sello${sis.estado === 'curso' ? ' sello-acento' : ''}`}>
              {sis.estado === 'curso' ? s.estadoCurso : s.estadoServicio}
            </span>
          </div>
          <span style="font-size:0.8125rem;line-height:1.6;color:var(--texto-suave)">
            {sis.que[idioma]}
          </span>
          <span class="sello">{sis.stack.join(' · ')}</span>
          {sis.prueba && (
            <a class="vinculo" href={sis.prueba.url} target="_blank" rel="noopener noreferrer">
              {sis.prueba.texto} ↗
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>

<!-- 05 · Codigo abierto -->
<section id="codigo" class="pagina seccion scroll-mt-20">
  <div class="titular">
    <span class="sello sello-acento">05</span>
    <h2>{s.codigoTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.codigoEtiqueta}</span>
  </div>

  <p style="margin:0 0 1.75rem;max-width:var(--container-prosa);line-height:1.68;color:var(--texto-suave)">
    {s.codigoEntrada}
  </p>

  <div class="flex flex-col gap-6">
    {
      piezas.map((pieza, i) => (
        <article class="ficha" style={i < piezas.length - 1 ? separador : undefined}>
          <div class="meta">
            <span class="sello">{pieza.sello}</span>
            <a class="vinculo" href={pieza.url} target="_blank" rel="noopener noreferrer">
              {pieza.nombre} ↗
            </a>
          </div>
          <p>{pieza.que[idioma]}</p>
        </article>
      ))
    }
  </div>
</section>

<!-- 06 · Como trabajo -->
<section id="metodo" class="pagina seccion scroll-mt-20">
  <div class="titular">
    <span class="sello sello-acento">06</span>
    <h2>{s.metodoTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.metodoEtiqueta}</span>
  </div>

  <p style="margin:0 0 1.75rem;max-width:var(--container-prosa);line-height:1.68;color:var(--texto-suave)">
    {s.metodoEntrada}
  </p>

  <!--
    Se reutiliza la rejilla de decisiones de los case studies en vez de
    inventar un componente: numero en mono a la izquierda, paso a la derecha.
    En dos columnas desde 1024px, porque cinco pasos en fila dejarian
    parrafos de veinticinco caracteres por linea.
  -->
  <div class="decisiones metodo">
    {
      pasos.map((paso, i) => (
        <div class="decision">
          <p class="sello num">{String(i + 1).padStart(2, '0')}</p>
          <div>
            <h3>{paso.titulo[idioma]}</h3>
            <p>{paso.cuerpo[idioma]}</p>
          </div>
        </div>
      ))
    }
  </div>

  <p class="sello" style="margin:1.5rem 0 0">
    {s.metodoCierre}{' '}
    <a class="vinculo" href={REGISTRO_URL} target="_blank" rel="noopener noreferrer">
      {s.metodoEnlace} ↗
    </a>
  </p>
</section>

<!-- 07 · Stack -->
<section class="pagina seccion">
  <div class="titular">
    <span class="sello sello-acento">07</span>
    <h2>{s.stackTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.stackEtiqueta}</span>
  </div>

  <dl class="grid gap-x-9 gap-y-4 sm:grid-cols-2">
    {
      stack.map((g) => (
        <div>
          <dt class="sello">{g.grupo[idioma]}</dt>
          <dd style="margin:0.25rem 0 0;font-size:0.8125rem;line-height:1.7">
            {g.items.join(' · ')}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- 08 · Contacto -->
<section id="contacto" class="pagina seccion scroll-mt-20" style="padding-bottom:3rem">
  <div class="titular">
    <span class="sello sello-acento">08</span>
    <h2>{s.contactoTitulo}</h2>
    <span class="regla"></span>
    <span class="sello etiqueta">{s.contactoEtiqueta}</span>
  </div>

  <p style="margin:0 0 1.5rem;max-width:var(--container-prosa);line-height:1.68;color:var(--texto-suave)">
    {s.contactoEntrada}
  </p>

  <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
    {HAY_CV && <a class="vinculo" href="/cv.pdf">{s.heroCv}</a>}
    <a class="vinculo" href={`mailto:${CORREO}`}>{CORREO}</a>
    <a class="vinculo" href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a class="vinculo" href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>
    <span class="sello">{s.contactoLugar}</span>
  </div>
</section>
