---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { t, MARCA_URL, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
  /** Sobrescriben los de la portada en las paginas interiores. */
  titulo?: string;
  descripcion?: string;
  /**
   * Ruta dentro de cada idioma, sin barra inicial ni final. La portada es ''.
   * Se declara en los DOS idiomas porque de ahi salen la canonica y los
   * hreflang: una pagina interior que solo sabe su propia URL no puede
   * declarar su alternativa, y sin eso el sitio bilingue no lo es para Google.
   */
  ruta?: { en: string; es: string };
  /** `article` en los case studies; `profile` en la portada. */
  tipo?: 'profile' | 'article';
}

const {
  idioma,
  ruta = { en: '', es: '' },
  tipo = 'profile',
  titulo,
  descripcion,
} = Astro.props;
const s = t[idioma];

const tituloPagina = titulo ?? s.titulo;
const descripcionPagina = descripcion ?? s.descripcion;

const url = (i: Idioma) => {
  const camino = ruta[i];
  const base = i === 'en' ? '/' : '/es/';
  return new URL(camino ? `${base}${camino}/` : base, Astro.site);
};

const canonica = url(idioma);

/**
 * La barra tiene que saber donde esta. En una pagina interior los anclajes
 * (#notas, #trabajo) no apuntan a nada, y el conmutador de idioma debe llevar
 * a la MISMA pagina en el otro idioma, no a la portada.
 */
const raizIdioma = idioma === 'en' ? '/' : '/es/';
const enPortada = ruta[idioma] === '';
const otraUrl = url(idioma === 'en' ? 'es' : 'en').pathname;

/**
 * Tarjeta de enlace. Una por idioma, generada a mano y commiteada en public/:
 * un PNG que no cambia no justifica una dependencia de build.
 *
 * Sin esto, compartir el sitio en LinkedIn o WhatsApp mostraba un rectangulo
 * gris — que es literalmente la primera impresion de quien recibe el enlace.
 */
const tarjeta = new URL(idioma === 'en' ? '/og.png' : '/og-es.png', Astro.site);

/**
 * Datos estructurados. Su unico trabajo es que buscar el nombre devuelva este
 * sitio y no un homonimo. Todo lo de aqui esta tambien visible en la pagina:
 * marcar lo que no se muestra es justo lo que Google penaliza.
 */
const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Morán Vílchez',
  url: canonica.href,
  image: tarjeta.href,
  jobTitle: idioma === 'en' ? 'Full Stack Developer & Data Engineer' : 'Desarrollador full stack e ingeniero de datos',
  description: s.descripcion,
  email: 'mailto:skaan.dmv@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Piura', addressCountry: 'PE' },
  knowsLanguage: ['es', 'en'],
  sameAs: ['https://github.com/DanielMoranV', 'https://linkedin.com/in/danielmoranv', MARCA_URL],
  knowsAbout: [
    'Go', 'Laravel', 'PHP', 'Python', 'FastAPI', 'TypeScript', 'NestJS', 'Vue.js', 'React',
    'PostgreSQL', 'FoxPro', 'DBF', 'ETL', 'Legacy system modernization', 'Multi-tenant architecture',
    'SUNAT electronic invoicing', 'Docker', 'Flutter',
  ],
};
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Antes que cualquier estilo o marcado: la preferencia guardada se escribe
      en la raiz antes del primer pintado. Sin esto, quien haya elegido oscuro
      ve un destello blanco en cada carga, y un portafolio que parpadea se ve
      peor que uno sin conmutador.
    -->
    <script is:inline>
      const t = localStorage.getItem('tema');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    </script>

    <title>{tituloPagina}</title>
    <meta name="description" content={descripcionPagina} />
    <link rel="canonical" href={canonica} />

    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="es" href={url('es')} />
    <link rel="alternate" hreflang="x-default" href={url('en')} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Las tres familias se sirven desde el propio dominio: el sitio no hace ni
      una peticion a terceros. Se precargan las dos que pintan texto visible
      antes del scroll; Newsreader ademas es la del titular, que es lo primero
      que se lee.
    -->
    <link
      rel="preload"
      href="/fonts/newsreader.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="Daniel Morán Vílchez" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcionPagina} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={idioma === 'en' ? 'en_US' : 'es_PE'} />
    <meta property="og:image" content={tarjeta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.tarjetaAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={tarjeta} />

    <meta name="author" content="Daniel Morán Vílchez" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f10" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" set:html={JSON.stringify(persona)} is:inline />
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:px-4 focus:py-2"
      style="background: var(--enlace); color: var(--fondo);"
    >
      {idioma === 'en' ? 'Skip to content' : 'Saltar al contenido'}
    </a>

    <Nav idioma={idioma} raiz={raizIdioma} otra={otraUrl} enPortada={enPortada} />
    <main id="contenido"><slot /></main>

    <footer style="border-color: var(--borde); background: var(--fondo-hondo);" class="border-t">
      <div
        class="pagina flex flex-col gap-3 py-7 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="sello" style="margin:0">© {new Date().getFullYear()} {s.pieDerechos}</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a class="sello hover:underline" href={MARCA_URL} target="_blank" rel="noopener noreferrer">
            {s.pieMarca}
          </a>
          <a
            class="sello hover:underline"
            href="https://github.com/DanielMoranV"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </nav>
      </div>
    </footer>

    <!--
      El conmutador. Tres estados reales; «sistema» es la AUSENCIA de atributo
      en la raiz y de clave en localStorage, asi que sigue al sistema en vivo
      sin escuchar nada. Elegir claro gana sobre un sistema en oscuro gracias
      al :not([data-theme='light']) del CSS.

      Es el unico JavaScript del sitio, y no necesita framework.
    -->
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        const grupo = document.querySelector('.tema');
        if (!grupo) return;
        const metas = document.querySelectorAll('meta[name="theme-color"]');

        const aplicar = (v) => {
          // Unico punto donde se toca la raiz. Atributo de la raiz: data-theme.
          // Atributo de los botones: data-tema. No se mezclan.
          if (v === 'system') {
            raiz.removeAttribute('data-theme');
            localStorage.removeItem('tema');
          } else {
            raiz.dataset.theme = v;
            localStorage.setItem('tema', v);
          }
          const oscuro =
            v === 'dark' ||
            (v === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          metas.forEach((m) => {
            m.removeAttribute('media');
            m.content = oscuro ? '#0d0f10' : '#ffffff';
          });
          grupo
            .querySelectorAll('button')
            .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tema === v)));
        };

        aplicar(localStorage.getItem('tema') ?? 'system');
        grupo.addEventListener('click', (e) => {
          const b = e.target.closest('button[data-tema]');
          if (b) aplicar(b.dataset.tema);
        });
      })();
    </script>
  </body>
</html>
